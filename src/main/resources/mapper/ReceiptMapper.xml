<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.fuzuyang.trading.infrastructure.persistence.mapper.ReceiptMapper">

    <resultMap id="BaseResultMap" type="com.fuzuyang.trading.infrastructure.persistence.entity.ReceiptDO">
        <id column="id" property="id"/>
        <result column="order_no" property="orderNo"/>
        <result column="upstream_no" property="upstreamNo"/>
        <result column="status" property="status"/>
        <result column="amount" property="amount"/>
        <result column="payload" property="payload"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <insert id="insert" parameterType="com.fuzuyang.trading.infrastructure.persistence.entity.ReceiptDO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO t_receipt (order_no, upstream_no, status, amount, payload, created_at)
        VALUES (#{orderNo}, #{upstreamNo}, #{status}, #{amount}, #{payload}, #{createdAt})
    </insert>

    <select id="selectByOrderNo" resultMap="BaseResultMap">
        SELECT id, order_no, upstream_no, status, amount, payload, created_at
        FROM t_receipt
        WHERE order_no = #{orderNo}
    </select>

</mapper>
